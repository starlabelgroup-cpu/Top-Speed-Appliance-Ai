# ============================================================
# FRONTEND CONFIGURATION (Frontend .env)
# ============================================================

# AI Agent Backend API
VITE_REACT_APP_AGENT_API_URL=https://topspeed-ai-agent.herokuapp.com/api/v1

# Development (for local testing)
# VITE_REACT_APP_AGENT_API_URL=http://localhost:8000/api/v1

# OpenAI Configuration (for AI Ads Generator)
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Gemini AI Configuration (for Google Gemini integration)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Google Ads Configuration (for Google Ads API integration)
VITE_GOOGLE_ADS_API_KEY=your_google_ads_api_key_here
VITE_GOOGLE_ADS_CUSTOMER_ID=your_google_ads_customer_id_here
VITE_GOOGLE_ADS_DEVELOPER_TOKEN=your_google_ads_developer_token_here

# Supabase Configuration (for AI Ads Generator)
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Ad Manager Backend API
VITE_API_URL=http://localhost:5000

# ============================================================
# BACKEND CONFIGURATION (Backend .env)
# ============================================================

# Server Configuration
PORT=5000

# Database Configuration (PostgreSQL)
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=topspeed_dashboard

# Google Ads API Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token_here
GOOGLE_ADS_CUSTOMER_ID=your_customer_id_here
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token_here

# Twilio Configuration (for Call Tracking)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_TWIML_URL=http://demo.twilio.com/docs/voice.xml

# Gmail Configuration (for Email Notifications)
GMAIL_SERVICE_ACCOUNT_KEY=./service-account.json
GMAIL_FROM=service@topspeedappliance.net
COMPANY_PHONE=(305) 555-1234
